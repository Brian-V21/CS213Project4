<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="src.controller.CurrentOrderController">

    <top>
        <HBox spacing="10" padding="10">
            <children>
                <Label text="Current Order:"/>
                <Label fx:id="orderNumberLabel" text="Order #"/>
            </children>
        </HBox>
    </top>

    <center>
        <ListView fx:id="itemsList"/>
    </center>

    <bottom>
        <VBox spacing="5" padding="10">
            <children>
                <HBox spacing="10">
                    <children>
                        <Label text="Subtotal:"/>
                        <Label fx:id="subtotalLabel" text="$0.00"/>
                        <Label text="Tax:"/>
                        <Label fx:id="taxLabel" text="$0.00"/>
                        <Label text="Total:"/>
                        <Label fx:id="totalLabel" text="$0.00"/>
                    </children>
                </HBox>
                <HBox spacing="10">
                    <children>
                        <Button fx:id="removeItemBtn" text="Remove Selected"
                                onAction="#removeSelectedItem"/>
                        <Button fx:id="clearBtn" text="Remove All"
                                onAction="#clearCurrentOrder"/>
                        <Button fx:id="placeOrderBtn" text="Place Order"
                                onAction="#placeOrder"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </bottom>

</BorderPane>
